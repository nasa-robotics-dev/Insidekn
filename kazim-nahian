            const data = langData[currentLang];
            
            document.getElementById('lang-btn-text').innerText = data.btn;
            document.getElementById('badge-title').innerText = data.badgeTitle;
            document.getElementById('badge-sub').innerText = data.badgeSub;
            document.getElementById('hero-tagline').innerText = data.tagline;
            document.getElementById('hero-bio').innerText = data.bio;
