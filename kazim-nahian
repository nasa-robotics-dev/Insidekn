        .terminal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 10px; font-size: 0.75rem; color: #52649c; }
        .terminal-dots { display: flex; gap: 6px; }
