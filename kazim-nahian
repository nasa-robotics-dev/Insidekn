        #launch-screen.fade-out { opacity: 0; visibility: hidden; }

        .rocket {
            position: absolute; top: 40%; width: 80px; left: calc(50% - 40px);
            animation: launchFly 2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes launchFly {
            0% { transform: translateY(150px) scale(0.8); opacity: 0; }
            20% { opacity: 1; }
            80% { transform: translateY(-300px) scale(1.2); }
            100% { transform: translateY(-800px) scale(1.5); opacity: 0; }
