        .instagram svg path, .x svg path { stroke: #808080; transition: 0.4s ease-in-out; }
        .instagram:hover svg path { stroke: #cc39a4; }
        .x:hover svg path { stroke: #00e5ff; }
        .instagram:hover svg, .x:hover svg { scale: 1.3; }
        .instagram:hover:after, .x:hover:after { scale: 4; transform: translateX(0.09em) translateY(0.09em); }

        .contact-hub {
