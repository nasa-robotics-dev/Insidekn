        @keyframes bounce { 0% { transform: translateY(0); } 50% { transform: translateY(-4px); } 100% { transform: translateY(0); } }
        @keyframes exhaust { 0% { background: linear-gradient(to bottom, transparent 10%, #f5f5f5 100%); } 50% { background: linear-gradient(to bottom, transparent 8%, #f5f5f5 100%); } }
        @keyframes move { 0% { transform: translateX(0) translateY(0); } 50% { transform: translateY(1em) translateX(-1em); } 100% { transform: translateX(0) translateY(0); } }

        @media (max-width: 768px) {
            .hud-top { padding: 12px 20px; }
            .hud-left { display: none; }
            .right-cluster { width: 100%; justify-content: space-between; }
            .glitch { font-size: 2.1rem; }
            .control-panel { flex-direction: column; align-items: stretch; }
            .bdt-clock { text-align: center; }
        }
    </style>
</head>
