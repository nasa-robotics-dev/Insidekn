            document.getElementById('gateway-title').innerText = data.gatewayTitle;
            document.getElementById('gateway-content').innerHTML = data.gatewayContent;
            document.getElementById('contact-title').innerText = data.contactTitle;
            document.getElementById('contact-subtext').innerText = data.contactSub;
