            cursor: pointer; display: inline-flex; align-items: center; gap: 10px; transition: all 0.25s ease;
        }
        .btn-action:hover {
            border-color: var(--cyber-cyan); background: rgba(0, 229, 255, 0.12); box-shadow: 0 0 12px rgba(0,229,255,0.3); transform: translateY(-1px);
        }
        .btn-action i { color: var(--cyber-cyan); }

        .bdt-clock {
            font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text-muted);
            background: rgba(6, 15, 30, 0.8); border: 1px solid var(--border-color); padding: 8px 15px; border-radius: 4px;
