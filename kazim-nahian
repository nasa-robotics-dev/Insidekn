        .quantum-text h5 { color: #fff; font-size: 0.85rem; margin-bottom: 4px; letter-spacing: 0.5px; }
        .quantum-text p { color: var(--text-muted); font-size: 0.75rem; line-height: 1.5; font-family: 'Inter', sans-serif; }

        .terminal-box {
