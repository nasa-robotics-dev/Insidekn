        .spec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 60px; }
        .spec-card { background: rgba(11, 22, 44, 0.4); border: 1px solid rgba(255,255,255,0.06); padding: 20px; border-radius: 6px; font-family: 'JetBrains Mono', monospace; transition: 0.25s; }
